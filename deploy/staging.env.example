# Staging-only settings. Copy values into
# /srv/tda-staging/env/.env.staging on the VPS.
# Never commit the real .env.staging file or any real password/secret.

POSTGRES_DB=tda_staging
POSTGRES_USER=tda_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://tda_app:URL_ENCODED_PASSWORD@postgres:5432/tda_staging

APP_ORIGIN=https://staging.app.tdapekanbaru.id
AUTH_SESSION_TTL_HOURS=12

# Authentication secrets are mounted from VPS files via Docker Compose:
# /srv/tda-staging/env/auth_session_secret
# /srv/tda-staging/env/auth_password_pepper
# Do not place their values in this file or in Git.
