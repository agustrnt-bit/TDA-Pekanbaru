# Aplikasi saat ini menggunakan binding Cloudflare, bukan nilai rahasia di file.
# Isi hanya pada lingkungan target (VPS/Cloudflare), jangan commit .env asli.
APP_URL=
PORT=3000

# Database target VPS (aplikasi Versi 61 saat ini memakai binding D1 bernama DB).
DATABASE_URL=
D1_DATABASE_ID=

# Object storage target (aplikasi Versi 61 saat ini memakai binding R2 bernama BUCKET).
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
UPLOAD_PATH=

# Hanya diperlukan bila strategi autentikasi VPS kelak menggunakan secret sendiri.
JWT_SECRET=
AUTH_SECRET=
